<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="clr-namespace:SHCDESE.UI;assembly=SHCDESE">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">

            <!-- Player setting -->
            <TextBlock Text="GENERAL SETTINGS"
                       Foreground="#77AAFF"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Mod enabled"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="0,5"/>

                <CheckBox Grid.Row="0"
                            Grid.Column="2"
                            IsChecked="{Binding ModEnabled}"
                            Foreground="White"
                            Margin="0,5"
                            IsEnabled="{Binding IsHost}"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Show a message each time"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="0,5"/>

                <CheckBox Grid.Row="1"
                            Grid.Column="2"
                            IsChecked="{Binding ShowMessage}"
                            Foreground="White"
                            Margin="0,5"
                            IsEnabled="{Binding IsHost}"/>
            </Grid>

            
            <Separator Background="#444466" Margin="0,10"/>

            <!-- Gold Settings -->
            <TextBlock Text="GOLD SETTINGS"
                       Foreground="#77AAFF"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Minimum gold to share with others"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="0,5"/>

                <TextBox Grid.Row="0"
                         Grid.Column="2"
                         Width="80"
                         Margin="0,5"
                         Text="{Binding MinGoldToShare, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                         Foreground="White"
                         Background="#333355"
                         BorderBrush="#555577"
                         Padding="4,2"
                         ui:KeyboardCaptureBinding.Enabled="{Binding IsHost}"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Maxmium gold to get money"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="0,5"/>

                <TextBox Grid.Row="1"
                        Grid.Column="2"
                        Width="80"
                        Margin="0,5"
                        Text="{Binding MaxGoldToGet, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                        Foreground="White"
                        Background="#333355"
                        BorderBrush="#555577"
                        Padding="4,2"
                        ui:KeyboardCaptureBinding.Enabled="{Binding IsHost}"/>


                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Amount of gold send"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="0,5"/>

                <TextBox Grid.Row="2"
                         Grid.Column="2"
                         Width="80"
                         Margin="0,5"
                         Text="{Binding GoldAmountToShare, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                         Foreground="White"
                         Background="#333355"
                         BorderBrush="#555577"
                         Padding="4,2"
                         ui:KeyboardCaptureBinding.Enabled="{Binding IsHost}"/>

            </Grid>
        </StackPanel>
    </ScrollViewer>
</Grid>